# Brand Configuration
# Options: groundmounts | texasgroundmountsolar | backyardsolartexas | groundmountsolarguide
NEXT_PUBLIC_BRAND=groundmounts

# Mapbox — this exact name is what the code reads.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Geocoding country bias. Defaults to "us" when unset.
NEXT_PUBLIC_COUNTRY_CODE=us

# Airtable (for lead capture)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=appHj3GWCG2Cly2Ci
# Table ID (tblXXXXXXXXXXXXXX, from the Airtable URL) — NOT the table name.
# Only used to deep-link a record from the notification email; falls back to the base.
AIRTABLE_TABLE_ID=

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Where new leads are announced. Defaults to bert@groundmounts.com when unset.
NOTIFY_EMAIL=bert@groundmounts.com

# Upstash Redis — durable rate limiting, site cache and submit idempotency.
# Either naming works: the Vercel Marketplace integration injects the KV_ pair,
# a hand-provisioned Upstash database gives you the UPSTASH_ pair. Without them
# the app falls back to per-instance memory, which is fine for local dev.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Booking link used in the quote email CTA
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/groundmounts/consultation

# Anthropic — reads an uploaded electricity bill. Without it the upload button
# fails politely and the customer types their usage in, which always works.
ANTHROPIC_API_KEY=
# Overridable so a model change is an env var rather than a deploy.
# ANTHROPIC_MODEL=claude-sonnet-5

# NREL PVWatts v8 — free key from https://developer.nrel.gov/signup/
# Without it /api/site falls back to the Texas reference curve, which still
# works; the numbers are just generic rather than site-specific.
NREL_API_KEY=

# Vercel Blob — auto-injected on Vercel; needed locally to upload map screenshots.
BLOB_READ_WRITE_TOKEN=your_blob_rw_token

# Iframe embedding. Space-separated origin list, or unset for "*" (the default,
# required for brandless partner funnels).
# ALLOWED_FRAME_ORIGINS=https://groundmounts.com https://texasgroundmountsolar.com

# Set to "true" to run the bundle analyzer during build.
# ANALYZE=false
