# Brand Configuration
# Options: groundmounts | texasgroundmountsolar | backyardsolartexas | groundmountsolarguide
NEXT_PUBLIC_BRAND=groundmounts

# Mapbox — this exact name is what the code reads.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Geocoding country bias. Defaults to "us" when unset.
NEXT_PUBLIC_COUNTRY_CODE=us

# Airtable (for lead capture)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=appHj3GWCG2Cly2Ci
# Table ID (tblXXXXXXXXXXXXXX, from the Airtable URL) — NOT the table name.
# Only used to deep-link a record from the notification email; falls back to the base.
AIRTABLE_TABLE_ID=

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Where new leads are announced. Defaults to bert@groundmounts.com when unset.
NOTIFY_EMAIL=bert@groundmounts.com

# Upstash Redis — durable rate limiting, site cache and submit idempotency.
# Either naming works: the Vercel Marketplace integration injects the KV_ pair,
# a hand-provisioned Upstash database gives you the UPSTASH_ pair. Without them
# the app falls back to per-instance memory, which is fine for local dev.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Anthropic — reads an uploaded electricity bill. Without it the upload button
# fails politely and the customer types their usage in, which always works.
ANTHROPIC_API_KEY=
# Overridable so a model change is an env var rather than a deploy.
# ANTHROPIC_MODEL=claude-sonnet-5

# NREL PVWatts v8 — free key from https://developer.nrel.gov/signup/
# Without it /api/site falls back to the Texas reference curve, which still
# works; the numbers are just generic rather than site-specific.
NREL_API_KEY=

# Vercel Blob — auto-injected on Vercel; needed locally to upload map screenshots.
BLOB_READ_WRITE_TOKEN=your_blob_rw_token

# Iframe embedding. Space-separated origin list, or unset for "*" (the default,
# required for brandless partner funnels).
# ALLOWED_FRAME_ORIGINS=https://groundmounts.com https://texasgroundmountsolar.com

# Set to "true" to run the bundle analyzer during build.
# ANALYZE=false

# --- Save and resume ------------------------------------------------------
# Signs the "pick up where you left off" links. Any long random string; a
# 32-byte hex value is what production uses:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WITHOUT IT the Finish later button reports failure and /api/resume refuses
# every link — deliberately, because a link that cannot be verified must not be
# honoured. Rotating it invalidates every link already in somebody's inbox.
RESUME_SECRET=

# --- Email tracking -------------------------------------------------------
# Signs the Resend webhook that reports what the quote email did after it left.
# Get it when you add the endpoint in Resend: Webhooks -> your endpoint ->
# Signing Secret. It starts with whsec_.
# WITHOUT IT the webhook route refuses every delivery with a 401 — deliberately,
# because an unsigned POST to a public URL must not be able to mark a lead
# bounced. Nothing else is affected; quotes still send.
RESEND_WEBHOOK_SECRET=

# --- Analytics ------------------------------------------------------------
# PostHog. Blank keys are a complete no-op: the library is never even imported,
# because next.config.mjs inlines these so the branch is dropped at build time.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Conversions API — the server-side half of the pixel, deduplicated
# against it on the lead id. Absent means the server simply does not call Meta;
# the browser pixel is unaffected.
META_CAPI_TOKEN=

# Absolute URL of this deployment, used to build resume links for emails.
# Falls back to VERCEL_URL, then to the production host.
# NEXT_PUBLIC_SITE_URL=https://groundmounts-app.vercel.app

# --- Reporting (opt-in, local only) --------------------------------------
# `npm run report:funnel` needs a PostHog *personal* key, not the public one
# above, plus the numeric project id. Without them the script exits cleanly.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
